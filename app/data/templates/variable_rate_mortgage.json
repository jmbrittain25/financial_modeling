{
  "version": "1.0",
  "name": "Real Estate Investment with Variable-Rate Mortgage",
  "description": "Real Estate scenario using a stochastic external driver for interest rates, VariableRateLoanValue for payments, and home appreciation. Demonstrates interest rate risk + equity build-up with rich custom metrics.",
  "tags": [
    "real-estate",
    "mortgage",
    "interest-rate-risk",
    "driver",
    "template"
  ],
  "is_template": true,
  "start": "2026-04-01T00:00:00",
  "end": "2041-04-01T00:00:00",
  "initial_state": {
    "home_value": 520000.0,
    "mortgage_rate": 0.065,
    "cumulative_cash": 0.0
  },
  "event_builders": [
    {
      "metadata": {
        "type": "mortgage_payment"
      },
      "timing": {
        "type": "Interval",
        "interval": "P30D"
      },
      "value_gen": {
        "type": "VariableRateLoan",
        "principal": 420000.0,
        "initial_rate": 0.065,
        "term_months": 180,
        "rate_key": "mortgage_rate"
      }
    }
  ],
  "continuous_processes": [
    {
      "type": "appreciation",
      "rate": 0.035,
      "var": "home_value"
    }
  ],
  "external_drivers": [
    {
      "type": "discrete_rate",
      "name": "mortgage_rate_driver",
      "target_state_key": "mortgage_rate",
      "dist": {
        "type": "normal",
        "mean": 0.065,
        "std": 0.012
      },
      "timing": {
        "type": "Interval",
        "interval": "P90D"
      },
      "metadata": {}
    }
  ],
  "custom_metrics": [
    {
      "name": "final_home_equity",
      "description": "Approximate equity = home_value - remaining mortgage balance (tracked via state)",
      "metric_type": "final_state_value",
      "params": {
        "key": "home_value"
      },
      "display_format": "currency",
      "unit_label": "USD",
      "higher_is_better": true,
      "goal_value": 250000
    },
    {
      "name": "total_interest_paid",
      "description": "Cumulative interest cost over the life of the loan (via event metadata)",
      "metric_type": "sum_positive_events",
      "params": {
        "metadata_type": "interest"
      },
      "display_format": "currency",
      "higher_is_better": false
    },
    {
      "name": "max_rate_experienced",
      "description": "Highest mortgage rate observed during the simulation (via driver)",
      "metric_type": "final_state_value",
      "params": {
        "key": "mortgage_rate"
      },
      "display_format": "percent",
      "higher_is_better": false
    }
  ]
}